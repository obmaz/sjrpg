class_name MusicDirector
extends Node
## 지역별 배경 음악은 이전 곡을 정지한 뒤 다음 곡을 페이드 인한다. 동시에 두 곡을 재생하지 않는다.
## Tracks are generated by tools/prepare_music.py and are exactly one loop long, so looping is gapless.
## The "배경 음악" setting is separate from combat sound effects; it also pauses when the app loses focus.

const TRACKS := {
	"town": preload("res://assets/audio/music/town.ogg"),
	"field": preload("res://assets/audio/music/field.ogg"),
	"dungeon": preload("res://assets/audio/music/dungeon.ogg"),
}
const FADE_SECONDS := 1.6  # 전환 전체 길이. 페이드 아웃/인에 절반씩 사용한다.
const BASE_DB := -6.0
const CHECK_INTERVAL := 0.25

var game: Node
var current := ""
var _players := {}
var _level := {}
var _next_check := 0.0
var _focus_paused := false
var _applied_focus_pause := {}
var focus_pause_updates := 0


func _enter_tree() -> void:
	# Re-entering the same director restores streams without creating duplicate players.
	current = ""
	_next_check = 0.0
	for name: String in _players:
		var player: AudioStreamPlayer = _players[name]
		if is_instance_valid(player):
			player.stream = TRACKS[name]
			_applied_focus_pause[name] = false
			_level[name] = 0.0


func _exit_tree() -> void:
	# Release each owned Ogg decoder/playback while its player is still alive.
	# Merely freeing the parent can leave an active looping playback in AudioServer.
	current = ""
	_next_check = 0.0
	for name: String in _players:
		var player: AudioStreamPlayer = _players[name]
		if is_instance_valid(player):
			player.stop()
			player.stream = null
		_level[name] = 0.0
	_applied_focus_pause.clear()


func _ready() -> void:
	# Fades must keep running while a menu pauses the game tree.
	process_mode = Node.PROCESS_MODE_ALWAYS
	for name: String in TRACKS:
		var stream: AudioStreamOggVorbis = TRACKS[name]
		stream.loop = true
		var player := AudioStreamPlayer.new()
		# Web samples copy a full decoded song on resume. Long looping music
		# streams through the bounded audio mixer instead; sound effects keep samples.
		player.playback_type = AudioServer.PLAYBACK_TYPE_STREAM
		player.stream = stream
		player.volume_db = -80.0
		add_child(player)
		_applied_focus_pause[name] = false
		_players[name] = player
		_level[name] = 0.0


## Which track belongs where the hero stands: a cave overrides the town rule, which overrides the field.
static func context_for(game_node: Node) -> String:
	if game_node.dungeon.active:
		return "dungeon"
	if game_node.in_town(game_node.player.position):
		return "town"
	return "field"


func _process(delta: float) -> void:
	_next_check -= delta
	if _next_check <= 0.0:
		_next_check = CHECK_INTERVAL
		current = context_for(game) if Prefs.music_enabled and is_instance_valid(game) else ""
	step(delta)


## 서로 다른 조성과 박자의 곡이 섞이지 않도록 이전 재생기를 먼저 정지한다.
## 경계 왕복·동굴 진입으로 목표가 바뀌어도 새 곡을 겹쳐 시작하지 않는다.
func step(delta: float) -> void:
	var outgoing := false
	for name: String in _players:
		if name == current:
			continue
		_fade_track(name, 0.0, delta)
		var player: AudioStreamPlayer = _players[name]
		outgoing = outgoing or player.has_stream_playback()
	if _players.has(current) and not outgoing:
		_fade_track(current, 1.0, delta)


func _fade_track(name: String, target: float, delta: float) -> void:
	var level: float = move_toward(_level[name], target, delta / (FADE_SECONDS * 0.5))
	_level[name] = level
	var player: AudioStreamPlayer = _players[name]
	if level > 0.0:
		player.volume_db = BASE_DB + linear_to_db(level)
		if not player.has_stream_playback():
			player.play()
			# A new playback begins unpaused, independent of the last voice.
			_applied_focus_pause[name] = false
		_apply_focus_pause(name, player)
	elif player.has_stream_playback():
		player.stop()
		_applied_focus_pause[name] = false


## Godot4.7.2 Web sample pause(false) restarts and copies its AudioBuffer even
## when already playing. Never send a repeated unpause across that bridge.
func _apply_focus_pause(name: String, player: AudioStreamPlayer) -> void:
	if bool(_applied_focus_pause.get(name, false)) == _focus_paused:
		return
	player.stream_paused = _focus_paused
	_applied_focus_pause[name] = _focus_paused
	focus_pause_updates += 1


func level_of(name: String) -> float:
	return _level.get(name, 0.0)


func is_playing(name: String) -> bool:
	return (_players[name] as AudioStreamPlayer).playing


func _notification(what: int) -> void:
	var lost := what in [NOTIFICATION_WM_WINDOW_FOCUS_OUT, NOTIFICATION_APPLICATION_FOCUS_OUT, NOTIFICATION_APPLICATION_PAUSED]
	var back := what in [NOTIFICATION_WM_WINDOW_FOCUS_IN, NOTIFICATION_APPLICATION_FOCUS_IN, NOTIFICATION_APPLICATION_RESUMED]
	if not (lost or back):
		return
	_focus_paused = lost
	for name: String in _players:
		var player: AudioStreamPlayer = _players[name]
		if player.has_stream_playback():
			_apply_focus_pause(name, player)
		else:
			_applied_focus_pause[name] = false
