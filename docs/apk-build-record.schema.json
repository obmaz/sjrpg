{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "공통 APK 전달 기록",
  "description": "세 저장소의 latest-build.json 공통 형식. buildNumber와 versionCode는 같아야 한다.",
  "type": "object",
  "required": [
    "buildNumber",
    "versionName",
    "versionCode",
    "commit",
    "sourceDirty",
    "fileName",
    "sha256",
    "sizeBytes",
    "signingCertificateSha256",
    "contentHash",
    "builtAt"
  ],
  "additionalProperties": false,
  "properties": {
    "buildNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100000000
    },
    "versionName": {
      "type": "string",
      "minLength": 1
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100000000
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceDirty": {
      "type": "boolean"
    },
    "fileName": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.apk$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "signingCertificateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "builtAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
